# Copy this file to .env and add your keys.
# Best Buy (free): https://developer.bestbuy.com
BESTBUY_API_KEY=

# eBay (free): https://developer.ebay.com — create an app, then use the
# Application Keys (Client ID + Client Secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# SearchAPI.io (free, no card): https://www.searchapi.io
# Google Shopping multi-retailer price aggregation (Best Buy, Walmart, Newegg...)
SEARCHAPI_API_KEY=
